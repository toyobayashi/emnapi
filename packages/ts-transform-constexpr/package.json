{
  "name": "@emnapi/ts-transform-constexpr",
  "version": "1.0.0",
  "private": true,
  "description": "Compile-time conditional branches for TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "module-sync": "./dist/index.d.ts",
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.ts",
        "default": "./dist/index.d.ts"
      },
      "module-sync": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test ./test/index.js"
  },
  "peerDependencies": {
    "typescript": ">= 7.1.0-beta"
  }
}
